@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="display-4">
                <i class="fa fa-tachometer-alt text-primary"></i> 
                Welcome to ELS Management System
            </h1>
            <p class="lead">Manage students, grades, and academic records efficiently.</p>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4>@ViewBag.TotalStudents</h4>
                            <p>Total Students</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fa fa-users fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" asp-controller="Students" asp-action="Index">View Details</a>
                    <div class="small text-white"><i class="fa fa-angle-right"></i></div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4>@ViewBag.TotalTeachers</h4>
                            <p>Total Teachers</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fa fa-chalkboard-teacher fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" href="#">View Details</a>
                    <div class="small text-white"><i class="fa fa-angle-right"></i></div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-warning text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4>@ViewBag.TotalGrades</h4>
                            <p>Total Grades</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fa fa-chart-line fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" href="#">View Details</a>
                    <div class="small text-white"><i class="fa fa-angle-right"></i></div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-info text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4><i class="fa fa-calendar"></i></h4>
                            <p>Academic Year 2024-25</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fa fa-graduation-cap fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" href="#">Calendar</a>
                    <div class="small text-white"><i class="fa fa-angle-right"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fa fa-chart-bar me-1"></i>
                    Recent Grades
                </div>
                <div class="card-body">
                    @if (ViewBag.RecentGrades != null && ((List<SchoolManagementSystem.Models.Grade>)ViewBag.RecentGrades).Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Student</th>
                                        <th>Subject</th>
                                        <th>Grade</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var grade in (List<SchoolManagementSystem.Models.Grade>)ViewBag.RecentGrades)
                                    {
                                        <tr>
                                            <td>@grade.Student.FirstName @grade.Student.LastName</td>
                                            <td>@grade.Subject</td>
                                            <td>
                                                <span class="badge @(grade.Score >= 90 ? "bg-success" : grade.Score >= 80 ? "bg-warning" : "bg-danger")">
                                                    @grade.LetterGrade (@grade.Score%)
                                                </span>
                                            </td>
                                            <td>@grade.DateRecorded.ToString("MMM dd, yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No recent grades available.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fa fa-info-circle me-1"></i>
                    Quick Actions
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                        {
                            <a class="btn btn-outline-primary" asp-controller="Students" asp-action="Create">
                                <i class="fa fa-user-plus"></i> Add New Student
                            </a>
                            <a class="btn btn-outline-success" asp-controller="Students" asp-action="Index">
                                <i class="fa fa-users"></i> Manage Students
                            </a>
                        }
                        <a class="btn btn-outline-info" asp-controller="Profile" asp-action="Index">
                            <i class="fa fa-user"></i> View My Profile
                        </a>
                        @if (User.IsInRole("Student"))
                        {
                            <a class="btn btn-outline-warning" asp-controller="Profile" asp-action="Grades">
                                <i class="fa fa-chart-line"></i> View My Grades
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>